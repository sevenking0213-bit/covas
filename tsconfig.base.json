{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@covas/shared-types": ["packages/shared-types/src/index.ts"],
      "@covas/bridge": ["packages/bridge/src/index.ts"],
      "@covas/adapter-codex": ["packages/adapter-codex/src/index.ts"],
      "@covas/session-store": ["packages/session-store/src/index.ts"],
      "@covas/workspace": ["packages/workspace/src/index.ts"],
      "@covas/adapter-web": ["packages/adapter-web/src/index.ts"]
    }
  }
}
